DEFINE TABLE tunnel_connector TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD constellationId ON tunnel_connector TYPE record<constellation>;
DEFINE FIELD habitatNodeId ON tunnel_connector TYPE record<infrastructure_node>;
DEFINE FIELD horizonNodeId ON tunnel_connector TYPE record<infrastructure_node>;
DEFINE FIELD connectorKey ON tunnel_connector TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD protocol ON tunnel_connector TYPE string ASSERT $value IN ['nova-yamux-v1', 'frp'];
DEFINE FIELD status ON tunnel_connector TYPE string ASSERT $value IN ['registering', 'online', 'degraded', 'offline', 'revoked'];
DEFINE FIELD legacyFrpClientId ON tunnel_connector TYPE none | record<frp_client>;
DEFINE FIELD connectedAt ON tunnel_connector TYPE none | datetime;
DEFINE FIELD lastSeenAt ON tunnel_connector TYPE none | datetime;
DEFINE FIELD metadata ON tunnel_connector TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON tunnel_connector TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON tunnel_connector TYPE datetime DEFAULT time::now();
DEFINE INDEX tunnel_connector_horizon_key_idx ON tunnel_connector FIELDS horizonNodeId, connectorKey UNIQUE;
DEFINE INDEX tunnel_connector_habitat_idx ON tunnel_connector FIELDS habitatNodeId;
DEFINE INDEX tunnel_connector_status_idx ON tunnel_connector FIELDS status;
DEFINE INDEX tunnel_connector_legacy_idx ON tunnel_connector FIELDS legacyFrpClientId UNIQUE;

DEFINE TABLE domain_binding TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD userId ON domain_binding TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD studioId ON domain_binding TYPE record<studio>;
DEFINE FIELD host ON domain_binding TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD kind ON domain_binding TYPE string ASSERT $value IN ['platform', 'custom'];
DEFINE FIELD ownershipStatus ON domain_binding TYPE string ASSERT $value IN ['pending', 'verified', 'failed', 'revoked'];
DEFINE FIELD certificateStatus ON domain_binding TYPE string ASSERT $value IN ['pending', 'issuing', 'active', 'renewal_due', 'failed', 'revoked'];
DEFINE FIELD verificationToken ON domain_binding TYPE none | string;
DEFINE FIELD legacyProxyDomainId ON domain_binding TYPE none | record<proxy_domain>;
DEFINE FIELD verifiedAt ON domain_binding TYPE none | datetime;
DEFINE FIELD createdAt ON domain_binding TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON domain_binding TYPE datetime DEFAULT time::now();
DEFINE INDEX domain_binding_host_idx ON domain_binding FIELDS host UNIQUE;
DEFINE INDEX domain_binding_studio_idx ON domain_binding FIELDS studioId;
DEFINE INDEX domain_binding_legacy_idx ON domain_binding FIELDS legacyProxyDomainId UNIQUE;

DEFINE TABLE deployment_route TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD domainBindingId ON deployment_route TYPE record<domain_binding>;
DEFINE FIELD deploymentId ON deployment_route TYPE record<deployment>;
DEFINE FIELD horizonNodeId ON deployment_route TYPE record<infrastructure_node>;
DEFINE FIELD tunnelConnectorId ON deployment_route TYPE record<tunnel_connector>;
DEFINE FIELD status ON deployment_route TYPE string ASSERT $value IN ['pending', 'validating', 'active', 'degraded', 'disabled', 'failed'];
DEFINE FIELD legacyWorkspaceProxyId ON deployment_route TYPE none | record<workspace_proxy>;
DEFINE FIELD activatedAt ON deployment_route TYPE none | datetime;
DEFINE FIELD failure ON deployment_route TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON deployment_route TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON deployment_route TYPE datetime DEFAULT time::now();
DEFINE INDEX deployment_route_domain_idx ON deployment_route FIELDS domainBindingId UNIQUE;
DEFINE INDEX deployment_route_deployment_idx ON deployment_route FIELDS deploymentId;
DEFINE INDEX deployment_route_horizon_idx ON deployment_route FIELDS horizonNodeId;
DEFINE INDEX deployment_route_connector_idx ON deployment_route FIELDS tunnelConnectorId;
DEFINE INDEX deployment_route_legacy_idx ON deployment_route FIELDS legacyWorkspaceProxyId UNIQUE;
