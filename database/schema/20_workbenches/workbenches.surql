DEFINE TABLE workbench TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD userId ON workbench TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD studioId ON workbench TYPE record<studio>;
DEFINE FIELD name ON workbench TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD slug ON workbench TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD status ON workbench TYPE string ASSERT $value IN ['creating', 'ready', 'busy', 'paused', 'expired', 'failed', 'archived'];
DEFINE FIELD sourceVolumeKey ON workbench TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD activeInstanceId ON workbench TYPE none | record<workbench_instance>;
DEFINE FIELD defaultTargetProfileId ON workbench TYPE none | record<build_target_profile>;
DEFINE FIELD legacyWorkspaceId ON workbench TYPE none | record<workspace>;
DEFINE FIELD metadata ON workbench TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON workbench TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON workbench TYPE datetime DEFAULT time::now();
DEFINE INDEX workbench_studio_slug_idx ON workbench FIELDS studioId, slug UNIQUE;
DEFINE INDEX workbench_user_idx ON workbench FIELDS userId;
DEFINE INDEX workbench_status_idx ON workbench FIELDS status;
DEFINE INDEX workbench_legacy_workspace_idx ON workbench FIELDS legacyWorkspaceId UNIQUE;

DEFINE TABLE workbench_instance TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD workbenchId ON workbench_instance TYPE record<workbench>;
DEFINE FIELD nodeId ON workbench_instance TYPE record<infrastructure_node>;
DEFINE FIELD provider ON workbench_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD providerInstanceId ON workbench_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD status ON workbench_instance TYPE string ASSERT $value IN ['allocating', 'starting', 'ready', 'busy', 'pausing', 'paused', 'stopping', 'stopped', 'expired', 'unhealthy', 'failed'];
DEFINE FIELD sourceMountPath ON workbench_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD previewEndpoint ON workbench_instance TYPE none | string;
DEFINE FIELD expiresAt ON workbench_instance TYPE none | datetime;
DEFINE FIELD lastHeartbeatAt ON workbench_instance TYPE none | datetime;
DEFINE FIELD failure ON workbench_instance TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON workbench_instance TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON workbench_instance TYPE datetime DEFAULT time::now();
DEFINE INDEX workbench_instance_provider_idx ON workbench_instance FIELDS provider, providerInstanceId UNIQUE;
DEFINE INDEX workbench_instance_workbench_idx ON workbench_instance FIELDS workbenchId;
DEFINE INDEX workbench_instance_node_idx ON workbench_instance FIELDS nodeId;
DEFINE INDEX workbench_instance_status_idx ON workbench_instance FIELDS status;
