DEFINE TABLE deployment TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD userId ON deployment TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD studioId ON deployment TYPE record<studio>;
DEFINE FIELD environment ON deployment TYPE string ASSERT $value IN ['preview', 'staging', 'production'];
DEFINE FIELD releaseId ON deployment TYPE record<release>;
DEFINE FIELD previousReleaseId ON deployment TYPE none | record<release>;
DEFINE FIELD status ON deployment TYPE string ASSERT $value IN ['pending', 'provisioning', 'verifying', 'ready', 'activating', 'active', 'degraded', 'failed', 'stopped', 'superseded'];
DEFINE FIELD activeRuntimeInstanceId ON deployment TYPE none | record<runtime_instance>;
DEFINE FIELD legacyDeploymentId ON deployment TYPE none | record<workspace_deployment>;
DEFINE FIELD activatedAt ON deployment TYPE none | datetime;
DEFINE FIELD failure ON deployment TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON deployment TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON deployment TYPE datetime DEFAULT time::now();
DEFINE INDEX deployment_studio_environment_idx ON deployment FIELDS studioId, environment;
DEFINE INDEX deployment_release_idx ON deployment FIELDS releaseId;
DEFINE INDEX deployment_status_idx ON deployment FIELDS status;
DEFINE INDEX deployment_legacy_idx ON deployment FIELDS legacyDeploymentId UNIQUE;

DEFINE TABLE runtime_instance TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD deploymentId ON runtime_instance TYPE record<deployment>;
DEFINE FIELD nodeId ON runtime_instance TYPE record<infrastructure_node>;
DEFINE FIELD provider ON runtime_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD providerInstanceId ON runtime_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD status ON runtime_instance TYPE string ASSERT $value IN ['provisioning', 'starting', 'healthy', 'unhealthy', 'draining', 'stopped', 'failed'];
DEFINE FIELD serviceKey ON runtime_instance TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD healthCheck ON runtime_instance TYPE object FLEXIBLE;
DEFINE FIELD legacyRuntimeProcessId ON runtime_instance TYPE none | record<runtime_process>;
DEFINE FIELD startedAt ON runtime_instance TYPE none | datetime;
DEFINE FIELD stoppedAt ON runtime_instance TYPE none | datetime;
DEFINE FIELD failure ON runtime_instance TYPE none | object FLEXIBLE;
DEFINE FIELD createdAt ON runtime_instance TYPE datetime DEFAULT time::now();
DEFINE FIELD updatedAt ON runtime_instance TYPE datetime DEFAULT time::now();
DEFINE INDEX runtime_instance_provider_idx ON runtime_instance FIELDS provider, providerInstanceId UNIQUE;
DEFINE INDEX runtime_instance_deployment_idx ON runtime_instance FIELDS deploymentId;
DEFINE INDEX runtime_instance_node_status_idx ON runtime_instance FIELDS nodeId, status;
DEFINE INDEX runtime_instance_service_idx ON runtime_instance FIELDS serviceKey UNIQUE;
