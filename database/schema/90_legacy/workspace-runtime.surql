-- Exact 2026-07-13 live baseline for the legacy development/runtime model.
DEFINE TABLE runtime_process TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD command ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD createdAt ON runtime_process TYPE number PERMISSIONS FULL;
DEFINE FIELD cwd ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD healthCheckPath ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD label ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD lifecycleMode ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD logSummary ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD metadata ON runtime_process TYPE none | object FLEXIBLE PERMISSIONS FULL;
DEFINE FIELD pid ON runtime_process TYPE int PERMISSIONS FULL;
DEFINE FIELD port ON runtime_process TYPE none | int PERMISSIONS FULL;
DEFINE FIELD previewUrl ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD publicHost ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runCommand ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runtimeImage ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runtimeKind ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD sandboxId ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD statePath ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE FIELD status ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD studioId ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD updatedAt ON runtime_process TYPE number PERMISSIONS FULL;
DEFINE FIELD userId ON runtime_process TYPE string PERMISSIONS FULL;
DEFINE FIELD workspaceId ON runtime_process TYPE none | string PERMISSIONS FULL;
DEFINE INDEX runtime_process_sandbox_idx ON runtime_process FIELDS sandboxId;
DEFINE INDEX runtime_process_status_idx ON runtime_process FIELDS status;
DEFINE INDEX runtime_process_studio_idx ON runtime_process FIELDS studioId;
DEFINE INDEX runtime_process_user_idx ON runtime_process FIELDS userId;
DEFINE INDEX runtime_process_workspace_idx ON runtime_process FIELDS workspaceId;

DEFINE TABLE sandbox TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD createdAt ON sandbox TYPE number PERMISSIONS FULL;
DEFINE FIELD expiresAt ON sandbox TYPE number PERMISSIONS FULL;
DEFINE FIELD lastUsedAt ON sandbox TYPE number PERMISSIONS FULL;
DEFINE FIELD sandboxId ON sandbox TYPE string PERMISSIONS FULL;
DEFINE FIELD status ON sandbox TYPE string PERMISSIONS FULL;
DEFINE FIELD studioId ON sandbox TYPE none | string PERMISSIONS FULL;
DEFINE FIELD templateId ON sandbox TYPE string PERMISSIONS FULL;
DEFINE FIELD updatedAt ON sandbox TYPE number PERMISSIONS FULL;
DEFINE FIELD userId ON sandbox TYPE string PERMISSIONS FULL;
DEFINE FIELD workspaceId ON sandbox TYPE none | string PERMISSIONS FULL;
DEFINE INDEX sandbox_sandbox_idx ON sandbox FIELDS sandboxId UNIQUE;
DEFINE INDEX sandbox_studio_idx ON sandbox FIELDS studioId;
DEFINE INDEX sandbox_user_idx ON sandbox FIELDS userId;
DEFINE INDEX sandbox_workspace_idx ON sandbox FIELDS workspaceId;

DEFINE TABLE workspace TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD activeDeploymentId ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD buildCommand ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD buildPath ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD contentPath ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD createdAt ON workspace TYPE number PERMISSIONS FULL;
DEFINE FIELD defaultHost ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD framework ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD healthCheckPath ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD installCommand ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD lifecycleMode ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD name ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD outputDir ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD publicHost ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD rootPath ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD runCommand ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD runtimeImage ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runtimeKind ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD sandboxId ON workspace TYPE none | string PERMISSIONS FULL;
DEFINE FIELD scaffoldCommand ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD serveCommand ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD slug ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD sourcePath ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD statePath ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD status ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD studioId ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD templateKind ON workspace TYPE string PERMISSIONS FULL;
DEFINE FIELD updatedAt ON workspace TYPE number PERMISSIONS FULL;
DEFINE FIELD userId ON workspace TYPE string PERMISSIONS FULL;
DEFINE INDEX workspace_active_deployment_idx ON workspace FIELDS activeDeploymentId;
DEFINE INDEX workspace_slug_idx ON workspace FIELDS studioId, slug UNIQUE;
DEFINE INDEX workspace_status_idx ON workspace FIELDS status;
DEFINE INDEX workspace_studio_idx ON workspace FIELDS studioId;
DEFINE INDEX workspace_user_idx ON workspace FIELDS userId;

DEFINE TABLE workspace_deployment TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD activatedAt ON workspace_deployment TYPE none | number PERMISSIONS FULL;
DEFINE FIELD artifactPath ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD buildCommand ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD createdAt ON workspace_deployment TYPE number PERMISSIONS FULL;
DEFINE FIELD healthCheckPath ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD lifecycleMode ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD metadata ON workspace_deployment TYPE none | object FLEXIBLE PERMISSIONS FULL;
DEFINE FIELD outputDir ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD publicHost ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD revision ON workspace_deployment TYPE int PERMISSIONS FULL;
DEFINE FIELD runCommand ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runtimeImage ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD runtimeKind ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD serveCommand ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD statePath ON workspace_deployment TYPE none | string PERMISSIONS FULL;
DEFINE FIELD status ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD studioId ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD updatedAt ON workspace_deployment TYPE number PERMISSIONS FULL;
DEFINE FIELD userId ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE FIELD workspaceId ON workspace_deployment TYPE string PERMISSIONS FULL;
DEFINE INDEX workspace_deployment_revision_idx ON workspace_deployment FIELDS workspaceId, revision UNIQUE;
DEFINE INDEX workspace_deployment_status_idx ON workspace_deployment FIELDS status;
DEFINE INDEX workspace_deployment_studio_idx ON workspace_deployment FIELDS studioId;
DEFINE INDEX workspace_deployment_user_idx ON workspace_deployment FIELDS userId;
DEFINE INDEX workspace_deployment_workspace_idx ON workspace_deployment FIELDS workspaceId;
