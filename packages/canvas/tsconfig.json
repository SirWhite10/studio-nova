{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "exclude": [
    "src/lib/base/**/docs.svelte",
    "src/lib/base/**/example.svelte",
    "src/lib/base/editor/fields/ArrayField.svelte",
    "src/lib/base/editor/fields/BooleanField.svelte",
    "src/lib/base/editor/fields/ColorField.svelte",
    "src/lib/base/editor/fields/IconField.svelte",
    "src/lib/base/editor/fields/ImageField.svelte",
    "src/lib/base/editor/fields/LinkField.svelte",
    "src/lib/base/editor/fields/NumberField.svelte",
    "src/lib/base/editor/fields/ObjectField.svelte",
    "src/lib/base/editor/fields/RichTextField.svelte",
    "src/lib/base/editor/fields/SelectField.svelte",
    "src/lib/base/editor/fields/SizeField.svelte",
    "src/lib/base/editor/fields/SpacingField.svelte",
    "src/lib/base/editor/fields/TextField.svelte"
  ]
}
