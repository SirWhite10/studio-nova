# Nova Edge — .env.example
#
# Copy this to .env and fill in the values.
# All variables can also be set via environment or a TOML config file.

# ── Core ──────────────────────────────────────────────────────
# Required — public hostname of this edge service
NOVA_EDGE_HOSTNAME=domains.dlxstudios.com

# Required — admin API token for Nova Cloud to call domain control endpoints.
# Generate with: openssl rand -hex 32
# Must match NOVA_DOMAIN_CONTROL_TOKEN set in Nova Cloud's env.
NOVA_EDGE_ADMIN_TOKEN=

# Optional — domain control API listen port (default: 8790)
# NOVA_EDGE_API_PORT=8790

# Optional — log level: debug, info, warn, error (default: info)
# NOVA_EDGE_LOG_LEVEL=info

# ── SurrealDB ─────────────────────────────────────────────────
# Required — SurrealDB connection URL
NOVA_EDGE_SURREAL_URL=ws://10.43.33.86:8000/rpc

# Optional — SurrealDB namespace (default: main)
# NOVA_EDGE_SURREAL_NAMESPACE=main

# Optional — SurrealDB database (default: main)
# NOVA_EDGE_SURREAL_DATABASE=main

# Optional — SurrealDB credentials
# NOVA_EDGE_SURREAL_USERNAME=root
# NOVA_EDGE_SURREAL_PASSWORD=root

# ── Tunnel (FRP) ──────────────────────────────────────────────
# Required — shared token for frpc client authentication
# Generate with: openssl rand -hex 32
# Must match the token in frpc.toml on the local K8s cluster.
NOVA_EDGE_TUNNEL_TOKEN=

# Optional — tunnel control plane port (default: 9443)
# NOVA_EDGE_TUNNEL_PORT=9443

# Optional — tunnel bind address (default: 0.0.0.0)
# NOVA_EDGE_TUNNEL_BIND_ADDR=0.0.0.0

# ── TLS ───────────────────────────────────────────────────────
# Optional — email for Let's Encrypt notifications
# NOVA_EDGE_TLS_EMAIL=admin@dlxstudios.com

# Optional — cert storage directory (default: /var/lib/nova-edge/certs)
# NOVA_EDGE_TLS_CACHE_DIR=/var/lib/nova-edge/certs

# Optional — ACME CA directory (default: Let's Encrypt production)
# For testing, use: https://acme-staging-v02.api.letsencrypt.org/directory
# NOVA_EDGE_TLS_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ── Domain Control ────────────────────────────────────────────
# Required — base domain for generated subdomains
NOVA_EDGE_SUBDOMAIN_HOST=dlx.studio

# Optional — TXT record prefix for domain verification (default: _nova-domain)
# NOVA_EDGE_VERIFICATION_PREFIX=_nova-domain

# Optional — FRP plugin auth token for /frp/handler endpoint
# If set, frps plugin requests must include this token
# NOVA_EDGE_FRP_PLUGIN_TOKEN=

# ── Nova Cloud Integration ────────────────────────────────────
# These are NOT set in Nova Edge's env — they go in Nova Cloud's env.
# Documented here for reference.
#
# In Nova Cloud's .env:
#   NOVA_DOMAIN_CONTROL_URL=https://domains.dlxstudios.com:8790
#   NOVA_DOMAIN_CONTROL_TOKEN=<same value as NOVA_EDGE_ADMIN_TOKEN above>
